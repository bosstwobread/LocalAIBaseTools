{
  "manifest_version": 3,
  "name": "MacHelper Connector",
  "version": "1.0.1",
  "description": "Connect the Extension Market to MacHelper for AI-assisted tool discovery.",
  "permissions": [
    "nativeMessaging"
  ],
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MacHelper Connector"
  },
  "externally_connectable": {
    "matches": [
      "https://local-ai-extension.nelson007.com/*"
    ]
  }
}
