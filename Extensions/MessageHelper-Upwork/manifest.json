{
  "manifest_version": 3,
  "name": "MessageHelper — Upwork",
  "version": "1.3.0",
  "description": "Translate Upwork messages and polish message or feedback drafts through MacHelper.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MessageHelper settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/ab/messages/*",
        "https://www.upwork.com/nx/proposals/*",
        "https://www.upwork.com/ab/feedbacks/f/contract/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
